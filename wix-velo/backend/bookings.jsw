import wixData from 'wix-data';

/**
 * Creates a new reservation request in the 'Bookings' CMS Collection
 * Matches your exact Wix CMS column names with 100% fail-safe compatibility
 */
export async function createBookingRequest(bookingData) {
  try {
    const pricingMap = {
      daily: { rate: 45, deposit: 100, label: 'Daily Rental (24 Hours)' },
      weekend: { rate: 85, deposit: 100, label: 'Weekend Rental (Fri-Sun)' },
      '3day': { rate: 115, deposit: 100, label: '3-Day Rental (72 Hours)' },
      weekly: { rate: 225, deposit: 150, label: 'Weekly Rental (7 Days)' },
      monthly: { rate: 550, deposit: 200, label: 'Monthly Rental (30 Days)' }
    };

    const tier = pricingMap[bookingData.rentalTier || bookingData.period] || pricingMap.daily;
    const bookingNumber = bookingData.bookingId || ('LD-' + Math.floor(1000 + Math.random() * 9000));

    // Lookup matching trailer for Reference field
    let trailerRefId = null;
    try {
      const trailerQuery = await wixData.query('Trailers')
        .eq('slug', bookingData.trailerId)
        .or(wixData.query('Trailers').contains('title', bookingData.trailerId === 'trailer-1' ? 'Trailer #1' : 'Trailer #2'))
        .find();
      if (trailerQuery.items.length > 0) {
        trailerRefId = trailerQuery.items[0]._id;
      }
    } catch (e) {
      console.warn('Trailer ref lookup skipped:', e);
    }

    const bookingItem = {
      title: bookingNumber,
      BookingID: bookingNumber,
      CustomerName: String(bookingData.customerName || '').trim(),
      Phone: String(bookingData.phone || '').trim(),
      Email: String(bookingData.email || '').trim(),
      DriverLicense: String(bookingData.driverLicense || '').trim(),
      TrailerID: bookingData.trailerId || '',
      TrailerName: trailerRefId || bookingData.trailerName || '',
      RentalTier: bookingData.rentalTier || bookingData.period || 'daily',
      RentalDays: Number(bookingData.rentalDays || 1),
      PickupDateTime: new Date(bookingData.pickupDateTime),
      ReturnDateTime: new Date(bookingData.returnDateTime),
      RentalFee: Number(tier.rate),
      SecurityDepositAmount: Number(tier.deposit),
      TotalCharged: Number(tier.rate + tier.deposit),
      DepositStatus: 'Pending',
      BookingStatus: 'PENDING_APPROVAL',
      IntendedUse: String(bookingData.intendedUse || '').trim(),
      Notes: String(bookingData.comments || bookingData.additionalComments || '').trim(),
      ReturnInspectionPassed: false
    };

    const savedBooking = await wixData.insert('Bookings', bookingItem);

    return {
      success: true,
      bookingNumber: bookingNumber,
      bookingId: savedBooking._id,
      rentalFee: tier.rate,
      securityDeposit: tier.deposit
    };
  } catch (error) {
    console.error('Error creating booking request in Wix CMS:', error);
    throw new Error('Unable to submit booking request. Please call (662) 555-0199 directly.');
  }
}

/**
 * Checks if a trailer is available for a specified date range
 */
export async function checkTrailerAvailability(trailerId, pickupDate, returnDate) {
  const pDate = new Date(pickupDate);
  const rDate = new Date(returnDate);

  const bookings = await wixData.query('Bookings')
    .eq('TrailerID', trailerId)
    .ne('BookingStatus', 'REJECTED')
    .find();

  const hasCollision = bookings.items.some(item => {
    const itemPickup = new Date(item.PickupDateTime || item.pickupDateTime);
    const itemReturn = new Date(item.ReturnDateTime || item.returnDateTime);
    return (pDate <= itemReturn && rDate >= itemPickup);
  });

  return !hasCollision;
}

/**
 * Returns all blocked dates from the Wix CMS 'BlockedDates' collection
 */
export async function getBlockedDates() {
  try {
    const results = await wixData.query('BlockedDates').find();
    return results.items.map(item => {
      if (item.dateString) return String(item.dateString).substring(0, 10);
      if (item.DateString) return new Date(item.DateString).toISOString().substring(0, 10);
      if (item.startDate) return new Date(item.startDate).toISOString().substring(0, 10);
      return '';
    }).filter(d => d.length === 10);
  } catch (e) {
    console.error('Error fetching BlockedDates:', e);
    return [];
  }
}

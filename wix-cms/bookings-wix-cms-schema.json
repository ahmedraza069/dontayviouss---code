{
  "collectionName": "Bookings",
  "collectionId": "Bookings",
  "permissions": "Form submitters can create, Only Admin can read/update",
  "fields": [
    { "fieldKey": "title", "fieldName": "Booking Reference", "type": "Text", "required": true, "example": "LD-8392" },
    { "fieldKey": "BookingID", "fieldName": "Booking ID", "type": "Text", "required": true, "example": "LD-8392" },
    { "fieldKey": "CustomerName", "fieldName": "Full Name", "type": "Text", "required": true, "example": "John Doe" },
    { "fieldKey": "Phone", "fieldName": "Phone Number", "type": "Text", "required": true, "example": "(662) 555-0199" },
    { "fieldKey": "Email", "fieldName": "Email Address", "type": "Text", "required": true, "example": "john@example.com" },
    { "fieldKey": "DriverLicense", "fieldName": "Driver License State & Number", "type": "Text", "required": true, "example": "MS - 123456789" },
    { "fieldKey": "TrailerID", "fieldName": "Trailer ID / Slug", "type": "Text", "required": true, "example": "trailer-1" },
    { "fieldKey": "TrailerName", "fieldName": "Trailer Name", "type": "Text", "required": true, "example": "Trailer #1: 6x12 Utility Trailer" },
    { "fieldKey": "RentalTier", "fieldName": "Rental Duration Tier", "type": "Text", "required": true, "example": "daily / weekend / 3day / weekly / monthly" },
    { "fieldKey": "RentalDays", "fieldName": "Rental Duration (Days)", "type": "Number", "required": true, "example": 1 },
    { "fieldKey": "PickupDateTime", "fieldName": "Pickup Date & Time", "type": "Date and Time", "required": true, "example": "2026-11-25T08:00:00" },
    { "fieldKey": "ReturnDateTime", "fieldName": "Return Date & Time", "type": "Date and Time", "required": true, "example": "2026-11-26T08:00:00" },
    { "fieldKey": "TowVehicle", "fieldName": "Tow Vehicle (Year/Make/Model)", "type": "Text", "required": false, "example": "2022 Ford F-150" },
    { "fieldKey": "RentalFee", "fieldName": "Rental Charge ($)", "type": "Number", "required": true, "example": 45 },
    { "fieldKey": "SecurityDepositAmount", "fieldName": "Refundable Security Deposit ($)", "type": "Number", "required": true, "example": 100 },
    { "fieldKey": "TotalCharged", "fieldName": "Total Hold / Charge ($)", "type": "Number", "required": true, "example": 145 },
    { "fieldKey": "IntendedUse", "fieldName": "Intended Hauling Purpose", "type": "Text", "required": false, "example": "Hauling zero turn mower" },
    { "fieldKey": "Notes", "fieldName": "Customer Notes", "type": "Text", "required": false, "example": "Will pickup at 9am" },
    { "fieldKey": "BookingStatus", "fieldName": "Reservation Status (Tag/Dropdown)", "type": "Text", "required": true, "example": "PENDING_APPROVAL / CONFIRMED / REJECTED / CANCELLED" },
    { "fieldKey": "IsApproved", "fieldName": "Approved by Owner (Toggle/Boolean)", "type": "Boolean", "required": true, "example": false },
    { "fieldKey": "DepositStatus", "fieldName": "Deposit Status", "type": "Text", "required": true, "example": "Pending / Paid / Refunded / Partially Deducted" },
    { "fieldKey": "PaymentStatus", "fieldName": "Payment Status", "type": "Text", "required": false, "example": "UNPAID / PAID / PAID_AT_PICKUP" },
    { "fieldKey": "PaymentLink", "fieldName": "Online Payment Link", "type": "URL", "required": false, "example": "https://yoursite.com/pay?bookingId=LD-3073" },
    { "fieldKey": "IsUrgent", "fieldName": "Same-Day / Next-Day Request", "type": "Boolean", "required": false, "example": false },
    { "fieldKey": "ReturnInspectionPassed", "fieldName": "Inspection Passed (Deposit Refund)", "type": "Boolean", "required": false, "example": false }
  ]
}
